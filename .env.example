# ============================================================================
# SITE CONFIGURATION
# ============================================================================
SITE_NAME=Hello World API
SITE_DOMAIN=kiro.fractus.io
SITE_URL=https://kiro.fractus.io
SITE_DESCRIPTION=Text transformation and analysis API for AI agents and developers
SITE_TAGLINE=Multi-language greetings and text processing
SITE_KEYWORDS=api, text processing, tokenization, sentiment analysis, language detection, ai agents

# ============================================================================
# ORGANIZATION & CONTACT
# ============================================================================
ORG_NAME=Fractus Labs
ORG_URL=https://github.com/dstar55
GITHUB_REPO=https://github.com/dstar55/hello-world-kiro
SUPPORT_EMAIL=support@example.com

# ============================================================================
# API CONFIGURATION
# ============================================================================
API_VERSION=1.2.0
MAX_TEXT_LENGTH=10000

# ============================================================================
# RATE LIMITING
# ============================================================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=100
RATE_LIMIT_PER_HOUR=1000

# ============================================================================
# MONITORING & LOGGING
# ============================================================================
MONITORING_ENABLED=true
LOG_LEVEL=INFO
DB_PATH=data/monitoring.db
LOG_DIR=logs

# ============================================================================
# REDIS CONFIGURATION
# ============================================================================
# For local development: redis://localhost:6379/0
# For Docker: redis://redis:6379/0
REDIS_URL=redis://localhost:6379/0
CACHE_ENABLED=true

# ============================================================================
# SECURITY
# ============================================================================
# Generate a secure random key for production: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=dev-secret-key-change-in-production
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme123

# ============================================================================
# FEATURE FLAGS
# ============================================================================
ENABLE_ADMIN_DASHBOARD=true
ENABLE_BATCH_PROCESSING=true
ENABLE_AGENT_TRACKING=true
